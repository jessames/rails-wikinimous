<div class="container">

  <h1 class="mt-4 mb-4"><%= @article.title %></h1>

  <p><%= @article.content %></p>

  <div class="row g-4">

    <%= link_to "Edit", edit_article_path(@article), class: "btn btn-primary mb-2" %>

    <%= link_to "Back to articles", articles_path, class: "btn btn-primary mb-2" %>

    <%= button_to "Delete", article_path(@article), class: "btn btn-primary mb-2", method: :delete, data: { turbo_confirm: "Delete?" } %>

  </div>

</div>
