<div class="container">

  <h1 class="mt-4 mb-4">Every Article</h1>

  <div class="row g-4">

    <% @articles.each do |article| %>
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= link_to article.title, article_path(article) %></h5>
            <p class="card-text"><%= article.content %></p>
            <%= link_to "Read Article", article_path(article), class: "btn btn-primary mt-auto" %>
          </div>
        </div>
      </div>
    <% end %>

  </div>
</div>

<%= link_to "Create a new article", new_article_path %>
